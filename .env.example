# Copia este archivo a ".env" (sin .example) y pega tu clave GRATIS.
# La app funciona sin clave (modo demo), pero con ella trae cuotas EN VIVO.

# The Odds API → https://the-odds-api.com  ("Get API Key", gratis, 500 créditos/mes)
ODDS_API_KEY=

# Cada cuántas horas se permite refrescar desde la API (caché). Sube este número
# para gastar menos créditos; bájalo para datos más frescos. Por defecto 8.
CACHE_TTL_HORAS=8
