# Copia este archivo a ".env" (sin .example) y pega tus claves GRATIS.
# La app funciona SIN claves (modo demo), pero con ellas trae cuotas EN VIVO.

# The Odds API  → https://the-odds-api.com  (Get API Key, plan gratis 500 req/mes)
ODDS_API_KEY=

# API-Football (opcional) → https://www.api-football.com  (free 100 req/día)
APIFOOTBALL_KEY=

# football-data.org (opcional) → https://www.football-data.org  (gratis con registro)
FOOTBALLDATA_KEY=
